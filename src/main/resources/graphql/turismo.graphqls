# The open data of Turismo de Portugal, the national tourism authority, from its ArcGIS server: the registers of 
# local lodging, tourist establishments, travel agencies and tourist activity operators, hotel projects, casinos 
# and bingo halls, golf courses, marinas, Blue Flag sites, surf spots, village networks, heritage sites, spas, 
# and walking, cycling and pilgrim routes. A generator outside the repository writes this file and 
# turismo/arcgis.json; the names and descriptions are written for the model.

extend type Query {
    """
    The local lodging units of Portugal (alojamento local), the holiday rentals of the national register RNAL:
    apartments, houses, rooms and hostels let to tourists, with their kind, guests and address. totalCount
    with a municipality answers how many units are registered there.
    """
    turismoLocalLodging(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        """
        The kind of unit: Apartamento (an apartment), Moradia (a house), Quartos (rooms in the owner's home),
        EstabelecimentoHospedagem (a guest house) or EstabelecimentoHospedagemHostel (a hostel).
        """
        kind: String
        "A part of the name, such as Ribeira. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoLocalLodgingPage

    """
    The tourist establishments open in Portugal (empreendimentos turísticos) in the national register RNET:
    hotels, apartment hotels, pousadas, holiday villages, tourist apartments, rural tourism and camping parks,
    with their stars, rooms and beds. totalCount with a municipality and a kind counts them, such as the
    five-star hotels of Porto.
    """
    turismoTouristEstablishments(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        """
        The kind of establishment: Hotel, HotelApartamento (apartment hotel), HotelRural (rural hotel),
        Pousada, AldeamentoTuristico (holiday village), ApartamentosTuristicos (tourist apartments),
        TurismoDeHabitacao (lodging in a manor house), CasaDeCampo (country house), Agroturismo (farm stay) or
        ParqueCampismo/Caravanismo (camping and caravan park).
        """
        kind: String
        "The number of stars, from 1 to 5, or 0 for an establishment without stars."
        stars: String
        "A part of the name, such as Pestana. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoTouristEstablishmentPage

    """
    The building projects of hotels and other tourist establishments that Turismo de Portugal approved
    (parecer favorável), new ones and changes to existing ones, with the rooms and beds they add.
    """
    turismoTouristEstablishmentProjects(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        """
        The kind of establishment, such as Hotel, HotelApartamento, HotelRural, Pousada, AldeamentoTuristico,
        ApartamentosTuristicos, TurismoDeHabitacao or EdAutCarUnifCT (detached houses in a tourist complex).
        """
        kind: String
        "A part of the name, such as Vau. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoTouristEstablishmentProjectPage

    """
    The prior information requests (pedidos de informação prévia) for hotels and other tourist establishments
    that Turismo de Portugal answered favourably: plans checked before a building project, with their rooms
    and beds.
    """
    turismoTouristEstablishmentPriorRequests(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        """
        The kind of establishment: Hotel, HotelApartamento (apartment hotel), HotelRural (rural hotel),
        AldeamentoTuristico (holiday village) or ApartamentosTuristicos (tourist apartments).
        """
        kind: String
        "A part of the name, such as Marriott. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoTouristEstablishmentPriorRequestPage

    """
    The tourist complexes of Portugal (conjuntos turísticos) in the RNET register: resorts that group several
    tourist establishments with shared facilities such as a golf course or a spa, with their beds.
    """
    turismoTouristComplexes(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Quinta. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoTouristComplexPage

    """
    The projects of tourist complexes (conjuntos turísticos, resorts that group several establishments) that
    Turismo de Portugal approved, with their planned beds and facilities.
    """
    turismoTouristComplexProjects(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Resort. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoTouristComplexProjectPage

    """
    The prior information requests for tourist complexes (resorts that group several establishments) that
    Turismo de Portugal answered favourably, with their planned beds and facilities.
    """
    turismoTouristComplexPriorRequests(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Falésia. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoTouristComplexPriorRequestPage

    """
    The tourism Projects of National Interest (PIN) that Turismo de Portugal is following now: large resorts
    with their area, beds, investment and jobs.
    """
    turismoNationalInterestProjects(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Sesimbra. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoNationalInterestProjectPage

    """
    The tourism Projects of National Interest (PIN) whose follow-up by Turismo de Portugal has ended: large
    resorts with their area and beds.
    """
    turismoCompletedNationalInterestProjects(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Tróia. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoCompletedNationalInterestProjectPage

    """
    The travel agencies of Portugal, one record per branch, from the national register RNAVT. totalCount with
    a municipality counts the branches there.
    """
    turismoTravelAgencies(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Abreu. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoTravelAgencyPage

    """
    The tourist activity operators of Portugal (agentes de animação turística) from the national register
    RNAAT: companies that run outdoor, nature, adventure, boat and cultural tours, one record per
    establishment.
    """
    turismoActivityOperators(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        """
        The kind of operator: EmpresaAnimacaoTuristica (a tourist activity company) or
        OperadorMaritimoTuristico (a boat tour operator).
        """
        kind: String
        "A part of the name, such as Aventura. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoActivityOperatorPage

    "The casinos of Portugal, with their operator, capacity, table games, slot machines and show rooms."
    turismoCasinos(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        """
        A part of the locality of the postal code, such as Estoril. Some casinos leave the municipality empty,
        and this filter finds them. Case does not matter.
        """
        locality: String
        "A part of the name, such as Estoril. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoCasinoPage

    "The bingo halls open in Portugal, with their operator and capacity."
    turismoBingoHalls(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        """
        A part of the locality of the postal code, such as Reboleira. Many halls leave the municipality empty,
        and this filter finds them. Case does not matter.
        """
        locality: String
        "A part of the name, such as Amadora. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoBingoHallPage

    """
    The golf courses in play in Portugal, registered with the Portuguese Golf Federation, with their holes,
    par, opening year and facilities.
    """
    turismoGolfCourses(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Bom Sucesso. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoGolfCoursePage

    """
    The villages of the Aldeias Históricas (Historic Villages) network of Portugal: fortified medieval
    villages of the interior, such as Sortelha, with their municipality and the body that manages the network.
    """
    turismoHistoricVillages(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Sortelha. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoHistoricVillagePage

    """
    The villages of the Aldeias de Montanha (Mountain Villages) network of Portugal: villages of the Serra da
    Estrela mountains, with their municipality and the body that manages the network.
    """
    turismoMountainVillages(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Loriga. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoMountainVillagePage

    """
    The villages of the Aldeias Vinhateiras (Wine Villages) network of Portugal: wine villages of the Douro
    valley, such as Trevões, with their municipality and the body that manages the network.
    """
    turismoWineVillages(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Trevões. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoWineVillagePage

    """
    The villages of the Aldeias do Xisto (Schist Villages) network of Portugal: villages built of schist in
    the centre of Portugal, such as Talasnal, with their municipality and the body that manages the network.
    """
    turismoSchistVillages(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Talasnal. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoSchistVillagePage

    """
    The Marian shrines of Portugal (altares marianos): churches, cathedrals and sanctuaries devoted to the
    Virgin Mary on the Caminhos da Fé (paths of faith).
    """
    turismoMarianShrines(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Sé Nova. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoMarianShrinePage

    """
    The places of Sephardic Jewish heritage in Portugal (herança judaica): synagogues, Jewish quarters,
    museums and memorials, such as those of Belmonte and Bragança.
    """
    turismoJewishHeritageSites(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Sefardita. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoJewishHeritageSitePage

    """
    The places of Islamic heritage in Portugal (legado islâmico): castles, baths, mosques and museums from the
    Moorish period, mostly in the Algarve and the Alentejo.
    """
    turismoIslamicHeritageSites(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Banhos. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoIslamicHeritageSitePage

    """
    The high performance centres for surfing, bodyboard and longboard in Portugal (centros de alto
    rendimento): training bases for athletes, with their sports, beds and opening year.
    """
    turismoSurfHighPerformanceCentres(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Peniche. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoSurfHighPerformanceCentrePage

    """
    The high performance centres for rowing, canoeing and other water sports in Portugal (centros de alto
    rendimento): training bases for athletes, with their sports, beds and opening year.
    """
    turismoNauticalHighPerformanceCentres(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Montemor-o-Velho. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoNauticalHighPerformanceCentrePage

    """
    The waves of the World Surfing Reserve of Ericeira, classified by Save The Waves, one record per wave and
    beach.
    """
    turismoSurfReserves(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "A part of the name, such as Pedra Branca. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoSurfReservePage

    """
    The main surf spots of Portugal from the Portugal Surf Guide, with their locality and whether they hold
    championships.
    """
    turismoSurfSpots(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Moledo. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoSurfSpotPage

    """
    The beaches of mainland Portugal with the Blue Flag (Bandeira Azul) of ABAAE this year, on the coast, on
    estuaries and inland. The layer names each municipality by its DICO code.
    """
    turismoBlueFlagBeaches(
        """
        The municipality's DICO code: two digits for the district and two for the municipality, such as 1312
        for Porto, 1317 for Vila Nova de Gaia or 1106 for Lisboa.
        """
        municipalityCode: Float
        """
        The kind of beach: Praia costeira (a coastal beach), Praia de transição (a beach on an estuary or a
        lagoon) or Praia interior (an inland beach on a river or a reservoir).
        """
        kind: String
        "A part of the name, such as Aldeia do Mato. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoBlueFlagBeachPage

    "The ecotourism boats of Portugal with the Blue Flag (Bandeira Azul) of ABAAE this year."
    turismoBlueFlagBoats(
        "A part of the name, such as Sun Boat. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoBlueFlagBoatPage

    """
    The marinas and recreational ports of Portugal with the Blue Flag (Bandeira Azul) of ABAAE this year.
    """
    turismoBlueFlagMarinas(
        "A part of the name, such as Lagos. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoBlueFlagMarinaPage

    """
    The marinas, recreational ports and docks of Portugal, on the sea and on rivers, with their berths, the
    largest boat they take and whether they have the Blue Flag.
    """
    turismoMarinas(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "The kind: Marina, PortoRecreio (a recreational port) or Doca (a recreational dock)."
        kind: String
        "A part of the name, such as Marina. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoMarinaPage

    """
    The cruise ship terminals of Portugal, such as Leixões, Lisboa and Portimão, with their quay length and
    depth.
    """
    turismoCruiseTerminals(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "A part of the name, such as Leixões. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoCruiseTerminalPage

    """
    The nautical stations of Portugal certified by Fórum Oceano: networks of water sports, boat trips and
    services around a stretch of coast, river or lake, with the head office of each.
    """
    turismoNauticalStations(
        "A municipality the station covers, such as Aveiro or Cascais. Case does not matter."
        municipality: String
        "A district the station covers, such as Faro. Case does not matter."
        district: String
        "A part of the name, such as Aveiro. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoNauticalStationPage

    """
    The areas the nautical stations of Portugal cover, certified by Fórum Oceano. Some areas are named Não
    Abrangido (not covered).
    """
    turismoNauticalStationAreas(
        "A municipality the station covers, such as Aveiro or Cascais. Case does not matter."
        municipality: String
        "A district the station covers, such as Faro. Case does not matter."
        district: String
        "A part of the name, such as Aveiro. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoNauticalStationAreaPage

    """
    The hotel and tourism schools of Turismo de Portugal (escolas de hotelaria e turismo), with their courses,
    student capacity, training hotel and auditorium.
    """
    turismoHotelSchools(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Porto. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoHotelSchoolPage

    """
    The thermal spas of Portugal (termas), with the illnesses their waters treat and their wellness
    programmes.
    """
    turismoThermalSpas(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Caldas. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoThermalSpaPage

    """
    The mountain bike centres of Portugal (centros BTT) approved by the Portuguese Cycling Federation: bases
    with marked trails for mountain biking.
    """
    turismoMountainBikeCentres(
        "The municipality, written with capitals and accents, such as Porto, Lisboa or Vila Nova de Gaia."
        municipality: String
        "The district, such as Porto, Lisboa or Faro."
        district: String
        "A part of the name, such as Odemira. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoMountainBikeCentrePage

    """
    The pilgrim ways to Fátima (Caminhos de Fátima), walked as an act of faith, with their length and stages.
    """
    turismoFatimaWays(
        "A part of the name, such as Rota Carmelita. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoFatimaWayPage

    "The Portuguese ways to Santiago de Compostela (Caminhos de Santiago), with their length and stages."
    turismoSantiagoWays(
        "A part of the name, such as Caminho da Costa. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoSantiagoWayPage

    """
    The greenways of Portugal for cycling (ecopistas): paths on old railway lines from the national greenway
    plan, with their length.
    """
    turismoCyclingGreenways(
        "A part of the name, such as Ecopista de Guimarães. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoCyclingGreenwayPage

    """
    The greenways of Portugal for walking (ecopistas): paths on old railway lines from the national greenway
    plan, with their length.
    """
    turismoWalkingGreenways(
        "A part of the name, such as Ecopista do Dão. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoWalkingGreenwayPage

    """
    The stretches in Portugal of the EuroVelo European cycle routes, such as EuroVelo 1 along the Atlantic
    coast, with their length.
    """
    turismoEuroveloRoutes(
        "A part of the name, such as Costa Atlântica. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoEuroveloRoutePage

    """
    The long-distance cycling routes of Portugal (Grandes Rotas, GR), such as GR22 through the historic
    villages, with their length.
    """
    turismoLongCyclingRoutes(
        "A part of the name, such as GR22. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoLongCyclingRoutePage

    """
    The long-distance hiking trails of Portugal (Grandes Rotas, GR), such as GR45 in the Côa valley, with
    their length.
    """
    turismoLongWalkingRoutes(
        "A part of the name, such as GR45. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoLongWalkingRoutePage

    """
    Other cycling routes of Portugal outside the long-distance network, such as the Ecovia do Rio Lima, with
    their length.
    """
    turismoOtherCyclingRoutes(
        "A part of the name, such as Ecovia. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoOtherCyclingRoutePage

    """
    Other walking routes of Portugal outside the long-distance network, such as the Rota Vicentina, with their
    length.
    """
    turismoOtherWalkingRoutes(
        "A part of the name, such as Rota Vicentina. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoOtherWalkingRoutePage

    """
    The UNESCO World Heritage sites of Portugal (Património Mundial), such as the historic centre of Porto and
    the garrison town of Elvas.
    """
    turismoUnescoWorldHeritageSites(
        "A part of the name, such as Porto. Case does not matter."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): TurismoUnescoWorldHeritageSitePage
