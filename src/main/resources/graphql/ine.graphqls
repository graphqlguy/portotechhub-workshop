"One value of an INE indicator, for one period, one place and one category of each other dimension."
type IneObservation {
    "The period of the value, such as 2023 for a year or September 2026 for a month."
    period: String!
    "INE's code of the place, such as PT for Portugal or 11A1312 for the municipality of Porto."
    placeCode: String
    "The name of the place, such as Porto."
    place: String
    "INE's code of the first category after the place, such as T for the total."
    categoryCode: String
    "The name of the first category after the place, such as Veterinary activities."
    category: String
    "Every category after the place, in the order of INE's dimensions."
    categories: [IneCategory!]!
    "The value as a number, or null when INE keeps it confidential or does not have one."
    value: Float
    "The value as INE writes it, with spaces between the thousands, such as 12 345."
    valueText: String
    "INE's note on the value, such as the reason it is confidential."
    note: String
}

"A category of one dimension of an INE indicator, such as a sex, an age group or an economic activity."
type IneCategory {
    "The number of the dimension, counted from 3, because dimension 1 is the period and dimension 2 the place."
    dimension: Int!
    "INE's code of the category, such as 75000 for veterinary activities."
    code: String
    "The name of the category."
    label: String
}

"A place of Portugal with the code that INE gives it."
type IneCode {
    "INE's code of the place, such as 11A1312 for the municipality of Porto."
    code: String!
    "The name of the place, such as Porto."
    name: String!
    "The level of the place: 1 for Portugal, then regions, subregions, and municipalities at the highest level."
    level: String
}
