scalar Date @specifiedBy(url: "https://scalars.graphql.org/andimarek/local-date")

# The entry point of our API. This line is a comment:
# comments start with # and are only for people reading this file.
"""
Reads the clinic's data.
An id identifies an object within its type, so an owner and a vet can have the same id.
"""
type Query {
    "Every owner of the clinic, in one list, without filters."
    ownersAll: [Owner!]! @deprecated(reason: "Unbounded. Use 'owners' instead.")

    "One owner, or null when no owner has the id. The owners query gives the ids of owners."
    owner(id: ID!): Owner

    """
    Owners, one page at a time, sorted by last name unless the sort argument says otherwise.
    A page past the last one holds an empty list.
    """
    owners(
        "Narrows the list by the start of the last name and by city. Leave it out to list every owner."
        filter: OwnerFilter
        "The page to return. Pages count from 0."
        page: Int! = 0
        "The number of owners on a page."
        size: Int! = 10
        sort: OwnerSort
    ): OwnerPage!

    "Every vet of the clinic, with their specialties."
    vets: [Vet!]!

    "One vet. The vets query gives the ids of vets."
    vet(id: ID!): Vet

    "The kinds of pet the clinic treats, sorted by name. The addPet and updatePet mutations take their ids as typeId."
    petTypes: [PetType!]!
}

"A client of the clinic, who owns one or more pets."
# We extend the Owner type as the workshop goes on
type Owner {
    id: ID!
    firstName: String!
    lastName: String!
    address: String!
    city: String!
    "The owner's telephone number as ten digits, for example 2221234567."
    telephone: String!
    pets: [Pet!]!
}

"An animal that an owner has registered with the clinic."
type Pet {
    id: ID!
    name: String!
    birthDate: Date
    type: PetType!
    owner: Owner!
    "The pet's visits to the clinic, oldest first."
    visits: [Visit!]!
}

"A kind of pet the clinic treats, such as cat or dog."
type PetType {
    id: ID!
    name: String!
}

enum OwnerSortField {
    LAST_NAME
    FIRST_NAME
    CITY
}

enum SortOrder {
    ASC
    DESC
}

input OwnerFilter {
    "Keeps the owners whose last name starts with this text. It matches in upper or lower case."
    lastName: String
    "Keeps the owners who live in this city. It matches in upper or lower case."
    city: String
}

input OwnerSort {
    field: OwnerSortField
    order: SortOrder
}

"One page of owners. Pages count from 0."
type OwnerPage {
    content: [Owner!]!
    totalElements: Int!
    totalPages: Int!
    currentPage: Int!
    size: Int!
    isFirst: Boolean!
    isLast: Boolean!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

"A veterinarian who works at the clinic."
type Vet {
    id: ID!
    firstName: String!
    lastName: String!
    specialties: [Specialty!]!
    "The visits this vet has seen or will see, newest first."
    visits: [Visit!]!
}

"A pet's visit to the clinic, in the past or booked for later."
type Visit {
    id: ID!
    date: Date!
    description: String!
    pet: Pet!
    "The vet who sees the pet, or null when the visit was booked without one, as the Petclinic web pages do."
    vet: Vet
}

"An area of veterinary medicine that a vet specializes in, such as surgery."
type Specialty {
    id: ID!
    name: String!
}

"Changes the clinic's data."
type Mutation {
    """
    Books a visit for a pet. Every call books one more visit, so after a call that failed or timed out,
    check the pet's visits before calling again.
    """
    addVisit(input: AddVisitInput!): Visit!

    """
    Registers a new owner. Every call registers one more owner, so calling it twice with the same input
    creates two owners.
    """
    addOwner(input: AddOwnerInput!): Owner!

    "Changes the details of an owner. Calling it again with the same input leaves the owner as it is."
    updateOwner(input: UpdateOwnerInput!): Owner!

    """
    Registers a new pet for an owner. An owner cannot have two pets with the same name,
    so a second call with the same name is refused.
    """
    addPet(input: AddPetInput!): Pet!

    "Changes the details of a pet. Calling it again with the same input leaves the pet as it is."
    updatePet(input: UpdatePetInput!): Pet!
}

input AddVisitInput {
    "The id of the pet the visit is for. The owner query gives the ids of pets."
    petId: ID!
    "The id of the vet who sees the pet, from the vets query. Leave it out to book the visit without a vet."
    vetId: ID
    "The day of the visit, written as 2026-10-21. Leave it out to book the visit for tomorrow."
    date: Date
    "The reason for the visit, at most 255 characters, for example a rabies shot."
    description: String!
}

input AddOwnerInput {
    firstName: String!
    lastName: String!
    address: String!
    city: String!
    "The owner's telephone number as ten digits, for example 2221234567."
    telephone: String!
}

"The details to change for one owner. A field left out keeps its value."
input UpdateOwnerInput {
    id: ID!
    firstName: String
    lastName: String
    address: String
    city: String
    telephone: String
}

input AddPetInput {
    "The id of the owner the pet belongs to. The owners query gives the ids of owners."
    ownerId: ID!
    "The pet's name, which must differ from the names of the owner's other pets."
    name: String!
    "The day the pet was born, written as 2024-05-01, today or earlier."
    birthDate: Date!
    "The id of the kind of pet, from the petTypes query."
    typeId: ID!
}

"The details to change for one pet. A field left out keeps its value."
input UpdatePetInput {
    id: ID!
    name: String
    birthDate: Date
    typeId: ID
}
