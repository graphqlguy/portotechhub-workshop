# The transparency portal of the Portuguese National Health Service (SNS), transparencia.sns.gov.pt: monthly and 
# yearly figures on hospitals, primary care, emergencies, medicines, staff, money and public health, mostly for 
# mainland Portugal, with one root field for each of its 149 datasets. A generator outside the repository writes 
# this file and sns/opendatasoft.json; the names and descriptions are written for the model.

extend type Query {
    """
    Hospital emergency visits by type (general, paediatric, obstetric, psychiatric), by hospital and month,
    2013 to August 2026. The counts add up from 1 January.
    """
    snsEmergencyVisitsByType(
        """
        Words of the health region's name, such as Norte for Região de Saúde Norte, or Lisboa e Vale do Tejo.
        """
        region: String
        "Words of the hospital's name, such as Santo António."
        hospital: String
        "The first month, such as 2026-01."
        from: String
        "The last month, such as 2026-08."
        to: String
        "The number of records to return, at most 100."
        first: Int = 20
    ): SnsEmergencyVisitsByTypePage

    """
    Medical outpatient consultations in public hospitals, by hospital and month, 2013 to August 2026. The
    counts add up from 1 January.
    """
    snsHospitalConsultations(
        """
        Words of the health region's name, such as Norte for Região de Saúde Norte, or Lisboa e Vale do Tejo.
        """
        region: String
        "Words of the hospital's name, such as Santo António."
        hospital: String
        "The first month, such as 2026-01."
        from: String
        "The last month, such as 2026-08."
        to: String
        "The number of records to return, at most 100."
        first: Int = 20
    ): SnsHospitalConsultationsPage

    """
