    """
    apaCoastalUnits(
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalUnitPage
}

"A page of ApaBathingWater records: how many match the arguments, and the first of them."
type ApaBathingWaterPage {
    "The number of records that match the arguments, across every page."
    totalCount: Int
    "The first records that match the arguments, at most 200."
    items: [ApaBathingWater!]
}

"""
A bathing water: a beach on the coast or on a river, as APA classifies it for the current bathing season.
"""
type ApaBathingWater {
    "The name of the beach, such as Praia de Matosinhos."
    name: String
    "The municipality, written in capitals, such as PORTO."
    municipality: String
    "The name of the bathing water that APA monitors at the beach, in capitals."
    waterBody: String
    "The European code of the bathing water, such as PTCF7N."
    waterCode: String
    "The hydrographic region office that manages the beach, such as ARH-NORTE or ARH-ALGARVE."
    region: String
    "True when the beach flies a blue flag in the current season."
    blueFlag: Boolean
    "The state of the water now, in Portuguese, such as Água adequada a banhos (water fit for bathing)."
    waterQuality: String
    """
    The classification from past seasons: 1 excellent, 2 good, 3 sufficient, 4 poor, 5 or 6 not classified
    yet.
    """
    waterClassification: Int
    "The kind of water: 1 coastal, 2 inland (a river or reservoir), 3 transitional (an estuary)."
    category: Int
    "The first day of the bathing season at the beach."
    seasonStart: Date
    "The last day of the bathing season at the beach."
    seasonEnd: Date
    "True when lifeguards watch the beach during the season."
    lifeguards: Boolean
    "True when the beach has a first aid post."
    firstAid: Boolean
    "True when the beach has toilets."
    toilets: Boolean
    "True when the beach has showers."
    showers: Boolean
    "True when the beach has parking."
    parking: Boolean
    "True when the beach is accessible to people with reduced mobility."
    accessible: Boolean
    "True when the beach has an amphibious chair for bathers with reduced mobility."
    amphibiousChair: Boolean
    "True when the beach has a risk of rockfall from the cliffs."
    cliffRisk: Boolean
    """
    Why bathing is advised against, in Portuguese, such as Presença de Salmonella; null when it is allowed.
    """
    alert: String
    "The address of the beach's page on APA's InfoPraia site."
    infoUrl: String
}

"A page of ApaBathingWaterClassification records: how many match the arguments, and the first of them."
type ApaBathingWaterClassificationPage {
    "The number of records that match the arguments, across every page."
    totalCount: Int
    "The first records that match the arguments, at most 200."
    items: [ApaBathingWaterClassification!]
}

"""
A bathing water with its classification from last season and the date and result of its latest analysis.
"""
type ApaBathingWaterClassification {
    "The name of the bathing water, in capitals, such as BISCOITOS."
    name: String
    "The European code of the bathing water, such as PTAD2T. apaBathingWaterAnalyses takes it."
    waterCode: String
    "The municipality, in capitals, such as PONTA DELGADA."
    municipality: String
    """
    Last season's class, in Portuguese: Excelente, Boa (good), Aceitável (sufficient), Má (poor) or Sem
    classificação.
    """
    lastSeasonClass: String
    "The latest verdict, in Portuguese, such as Água adequada a banhos (water fit for bathing)."
    latestResult: String
    "The day of the latest verdict on the water."
    latestResultDate: Date
    "The day of the latest analysis of the water."
    latestAnalysisDate: Date
    "Why bathing is advised against, such as Presença de Salmonella; null when the water is fit."
    reason: String
}

"A page of ApaBathingWaterAnalysis records: how many match the arguments, and the first of them."
type ApaBathingWaterAnalysisPage {
    "The number of records that match the arguments, across every page."
    totalCount: Int
    "The first records that match the arguments, at most 200."
    items: [ApaBathingWaterAnalysis!]
}

"""
One analysis of a bathing water: the day of the sample and its counts of Escherichia coli and intestinal
enterococci.
"""
type ApaBathingWaterAnalysis {
    "The European code of the bathing water, such as PTCF7N."
    waterCode: String
    "The day the sample was taken."
    date: Date
    "The count of Escherichia coli, in colony forming units per 100 millilitres."
    escherichiaColi: Int
    "A < when the count of Escherichia coli was below the limit of detection, which the count then gives."
    escherichiaColiFlag: String
    "The count of intestinal enterococci, in colony forming units per 100 millilitres."
    enterococci: Int
    "A < when the count of enterococci was below the limit of detection, which the count then gives."
    enterococciFlag: String
}

