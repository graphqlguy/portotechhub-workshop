    apaRadioactivitySamplingSites(
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaRadioactivitySamplingSitePage

    "The stations of Portugal's radioactivity alert network, with their kind and state."
    apaRadiationAlertStations(
        "The number of records to return, at most 200."
