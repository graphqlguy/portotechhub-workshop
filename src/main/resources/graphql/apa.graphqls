    apaDikesAndFloodgates(
        "A part of the name, such as Esmoriz."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaDikeOrFloodgatePage

    """
    The river basin management plans' record of the works that alter riverbeds and banks of mainland Portugal,
