# The layers of APA, the Portuguese Environment Agency (Agência Portuguesa do Ambiente), from its SNIAmb ArcGIS 
# server: bathing waters and beaches, rivers, reservoirs and dams, the state of surface and ground waters, flood 
# risk, the coastline and coastal erosion, protected areas and Natura 2000, air quality, noise, radioactivity, 
# waste, polluting installations, water use licences, and the climate atlas of Portugal. A generator outside the 
# repository writes this file and apa/arcgis.json; the names and descriptions are written for the model.

extend type Query {
    """
    The bathing waters of every municipality of Portugal: beaches on the coast, on rivers and on reservoirs,
    with the quality of their water, their facilities and whether they fly a blue flag this season. totalCount
    with a municipality answers how many beaches it has.
    """
    apaBathingWaters(
        "The municipality, such as Porto or Matosinhos. Case does not matter."
        municipality: String
        "A part of the beach's name, such as Nazaré or Comporta."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaBathingWaterPage

    """
    The classification of every bathing water of Portugal from the previous season, and the result of its
    latest analysis this season, from APA's water information system SNIRH.
    """
    apaBathingWaterClassifications(
        "The municipality, such as Porto or Ponta Delgada. Case does not matter."
        municipality: String
        "A part of the bathing water's name, such as Matosinhos."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaBathingWaterClassificationPage

    """
    The bacteria counts from the analyses of the bathing waters of Portugal this season, one record for each
    sample. Give the bathing water's code, from apaBathingWaters or apaBathingWaterClassifications, to get the
    samples of one beach.
    """
    apaBathingWaterAnalyses(
        "The European code of the bathing water, such as PTCF7N."
        waterCode: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaBathingWaterAnalysisPage

    """
    How full the beaches of Portugal are during the bathing season, as reported to APA's InfoPraia, with the
    capacity of each beach.
    """
    apaBeachOccupancy(
        "The municipality, such as Cascais or Matosinhos. Case does not matter."
        municipality: String
        "A part of the beach's name, such as Carcavelos."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaBeachOccupancyPage

    """
    The waves of special value for surfing and other sliding sports on the coast of mainland Portugal, as the
    coastal programmes (POC) protect them.
    """
    apaSurfWaves(
        "A part of the coastal programme's name, such as Ovar or Espichel."
        programme: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaSurfWavePage

    """
    The sea beaches of mainland Portugal by the type that the coastal programmes (POC) give them, from type I,
    an urban beach with intensive use, to type VI, a beach where use is forbidden.
    """
    apaCoastalBeachTypes(
        "A part of the beach's name, such as Leirosa."
        name: String
        "A part of the coastal programme's name, such as Ovar or Espichel."
        programme: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalBeachTypePage

    """
    The fishing communities on the beaches of mainland Portugal that the coastal programmes (POC) protect,
    such as Furadouro or Praia de Esmoriz.
    """
    apaFishingCommunities(
        "A part of the coastal programme's name, such as Ovar or Espichel."
        programme: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaFishingCommunityPage

    "The port areas inside the coastal programmes (POC) of mainland Portugal, such as Nazaré or Ericeira."
    apaCoastalPorts(
        "A part of the coastal programme's name, such as Ovar or Espichel."
        programme: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalPortPage

    """
    The towns of the coastal urban network in the coastal programmes (POC) of mainland Portugal, such as
    Figueira da Foz or Praia de Esmoriz.
    """
    apaCoastalTowns(
        "A part of the coastal programme's name, such as Ovar or Espichel."
        programme: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalTownPage

    """
    The safeguard strips of mainland Portugal: the strips of sandy coast that the coastal programmes (POC)
    keep free of building because the sea can overtop and flood them. Level I is the strip at risk within 50
    years and level II within 100 years.
    """
    apaCoastalFloodStrips(
        "A part of the coastal programme's name, such as Ovar or Espichel."
        programme: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalFloodStripPage

    """
    The safeguard strips of mainland Portugal: the strips of sandy coast that the coastal programmes (POC)
    keep free of building because the sea erodes them. Level I is the strip at risk within 50 years and level
    II within 100 years.
    """
    apaCoastalErosionStrips(
        "A part of the coastal programme's name, such as Ovar or Espichel."
        programme: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalErosionStripPage

    """
    The safeguard strips along the cliffs of mainland Portugal that the coastal programmes (POC) keep free of
    building, towards the sea and towards the land, because the cliffs can collapse.
    """
    apaCliffSafeguardStrips(
        "A part of the coastal programme's name, such as Ovar or Espichel."
        programme: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCliffSafeguardStripPage

    """
    The critical areas of the coast of mainland Portugal, where the coastal programmes (POC) plan to remove or
    relocate buildings exposed to the sea, such as Cova do Vapor or Fonte da Telha.
    """
    apaCoastalCriticalAreas(
        "A part of the place's name, such as Fonte da Telha."
        place: String
        "A part of the coastal programme's name, such as Espichel."
        programme: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalCriticalAreaPage

    """
    The zones of the older coastal zoning plans (POOC) of mainland Portugal, such as beaches of type I or
    natural areas, by plan.
    """
    apaCoastalZoningPlans(
        "A part of the plan's name, such as Ovar or Sintra."
        plan: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalZoningPlanPage

    """
    The coastal defence structures of mainland Portugal, such as groynes, seawalls, breakwaters and forts,
    with their condition, from APA's coastal information system SNIRLit.
    """
    apaCoastalStructures(
        "A part of the structure's name or place, such as Espinho or Moledo."
        name: String
        "The kind, in Portuguese, such as Esporão (groyne) or Paredão (seawall)."
        type: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalStructurePage

    """
    The stations that measure the sea and the weather on the coast of mainland Portugal, such as tide gauges,
    from APA's coastal information system SNIRLit.
    """
    apaCoastalStations(
        "A part of the station's name, such as Leixões."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalStationPage

    """
    The named beaches and places on the coast of mainland Portugal, with their parish and coastal unit, from
    APA's coastal information system SNIRLit.
    """
    apaCoastalPlaces(
        "A part of the place's name, such as Peralta."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalPlacePage

    """
    The modelled position of the coastline between Esmoriz and Leirosa for years from 2030 to 2100, under
    scenarios of intervention, such as removing a seawall or feeding the beaches with sand.
    """
    apaCoastlineScenarios(
        "A part of the stretch of coast, such as Furadouro."
        stretch: String
        "The year of the scenario, such as 2050."
        year: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastlineScenarioPage

    """
    The interventions tested in the coastline scenarios between Esmoriz and Leirosa, such as feeding a beach
    with sand or building a groyne, with the volume of sand they need.
    """
    apaCoastalInterventionPlans(
        "A part of the stretch of coast, such as Furadouro."
        stretch: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalInterventionPlanPage

    """
    The value of the private buildings in the coastal hazard zone from Caminha to Espinho, building by
    building, from the MarRISK study. totalCount with a municipality gives the number of exposed buildings.
    """
    apaCoastalBuildingValue(
        "The municipality, such as Espinho or Ovar. Case does not matter."
        municipality: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalBuildingValuePage

    """
    The occurrences on the coast of Portugal that APA records, such as cliff falls, overtopping by the sea,
    dune erosion and damage to coastal defences, with their date and place.
    """
    apaCoastalOccurrences(
        "The municipality, such as Albufeira or Ovar. Case does not matter."
        municipality: String
        "A part of the beach's name, such as Maria Luísa."
        beach: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalOccurrencePage

    """
    The interventions of the coastal action plan Litoral XXI, the studies and works to protect the coast of
    Portugal, with their cost, funding and state.
    """
    apaCoastalInterventions(
        "A part of the intervention's name, such as Espinho or Costa da Caparica."
        name: String
        "A municipality the intervention covers, such as Matosinhos."
        municipality: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalInterventionPage

    """
    The contracted actions of the coastal interventions of Portugal, such as repairing a groyne or stabilising
    a cliff, with their contract value and execution.
    """
    apaCoastalWorks(
        "A part of the action's name, such as Esporão (groyne) or Nazaré."
        name: String
        "The municipality, such as Espinho."
        municipality: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaCoastalWorkPage

    """
    The movements of sand on the coast of Portugal, such as feeding a beach with dredged sand, with their
    volume and dates, oldest first.
    """
    apaBeachNourishments(
        "The municipality, such as Matosinhos."
        municipality: String
        "A part of the place's name, such as Matosinhos."
        place: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaBeachNourishmentPage

    """
    The dams of the reservoirs that APA monitors in mainland Portugal, such as Alqueva or Castelo do Bode,
    with their river, height, year and reservoir size.
    """
    apaDams(
        "A part of the reservoir's name, such as Alqueva."
        name: String
        "The municipality, such as Moura. Case does not matter."
        municipality: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaDamPage

    """
    The public reservoirs of mainland Portugal, with their volume and uses: energy, public water supply,
    irrigation and boating.
    """
    apaPublicReservoirs(
        "A part of the reservoir's name, such as Aguieira."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaPublicReservoirPage

    """
    The public lagoons and lakes of mainland Portugal, such as Pateira de Fermentelos or Barrinha de Esmoriz.
    """
    apaPublicLakes(
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaPublicLakePage

    """
    How full the monitored reservoirs of Portugal are, in percent of their capacity, at the start of the
    latest month, for reservoirs such as Alto Lindoso or Aguieira. Low values signal drought.
    """
    apaReservoirStorage(
        "A part of the reservoir's name, such as Alqueva."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaReservoirStoragePage

    """
    The stations that measure the level and flow of the rivers of mainland Portugal, in APA's water
    information system SNIRH.
    """
    apaHydrometricStations(
        "A part of the station's name, such as Foz do Mouro."
        name: String
        "The municipality, such as Monção. Case does not matter."
        municipality: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaHydrometricStationPage

    """
    The rain gauges and weather stations of APA's network in mainland Portugal, in the water information
    system SNIRH.
    """
    apaWeatherStations(
        "A part of the station's name, such as Valença."
        name: String
        "The municipality, such as Valença. Case does not matter."
        municipality: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaWeatherStationPage

    """
    The stretches of the main rivers of mainland Portugal, with their length and slope, from APA's water
    atlas.
    """
    apaMainRivers(
        "A part of the river's name, such as Douro or Mondego."
        river: String
        "The river basin, such as Tejo."
        basin: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaMainRiverPage

    """
    The eight hydrographic regions of mainland Portugal, such as PTRH3 Douro, that the river basin management
    plans cover.
    """
    apaRiverBasinDistricts(
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaRiverBasinDistrictPage

    """
    The five regional offices of APA that manage water (ARH): Norte, Centro, Tejo e Oeste, Alentejo and
    Algarve, with their addresses.
    """
    apaRegionalWaterOffices(
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaRegionalWaterOfficePage

    "The land use plans of the public reservoirs of Portugal (POAAP), with the law that published them."
    apaReservoirPlans(
        "A part of the reservoir's name, such as Alqueva."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaReservoirPlanPage

    """
    The zones that the reservoir land use plans (POAAP) draw around public reservoirs, such as protection
    zones, tourist zones and zones for bathing or boating.
    """
    apaReservoirZoning(
        "A part of the reservoir's name, such as Apartadura."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaReservoirZonePage

    """
    The river rehabilitation projects of the ProRios programme in Portugal, with the stretch of river, the
    municipality, the cost and the state of the work.
    """
    apaRiverRehabilitation(
        "The municipality, such as Coimbra. Case does not matter."
        municipality: String
        "A part of the river's local name, such as Mondego."
        river: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaRiverRehabilitationPage

    """
    The large dams in the river basins of Portugal and the Spanish parts of shared basins, as pressures on the
    water bodies, with whether they have a fish pass and an ecological flow.
    """
    apaLargeDams(
        "A part of the dam's name, such as Alto Lindoso."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaLargeDamPage

    """
    The smaller dams and weirs, from 2 to 15 metres high, on the rivers of Portugal, as barriers that the
    river basin plans count.
    """
    apaDamsAndWeirs(
        "A part of the dam's name, such as Covas."
        name: String
        "A part of the water body's name, such as Rio Coura."
        river: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaDamOrWeirPage

    """
    The hydraulic works on the rivers of mainland Portugal, such as dams, weirs and reservoirs, with their
    purpose, height and volume.
    """
    apaHydraulicWorks(
        "A part of the work's name, such as Açude de Abrantes."
        name: String
        "A part of the water body's name, such as Zêzere."
        waterBody: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaHydraulicWorkPage

    """
    The monthly rainfall over each river basin of mainland Portugal and the whole country since October 2023,
    from APA's drought bulletin, with the gap to the historical mean. Give a basin to get its series, oldest
    first, about 84 months; months after the latest measurement hold 0.
    """
    apaBasinRainfall(
        "A part of the basin's name, such as Douro, Tejo or Nacional for the whole country."
        basin: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaBasinRainfallPage

    "The marks that past floods left in Portugal, with the height the water reached."
    apaFloodMarks(
        "A part of the place, such as Porto or Ribeira."
        place: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaFloodMarkPage

    """
    The stations that APA uses to watch the Tagus (Tejo) river closely, with the date of their latest data.
    """
    apaTagusStations(
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaTagusStationPage

    """
    The flows measured at the stations on the Tagus (Tejo) river, such as the mean daily inflow to the Fratel
    reservoir, newest first.
    """
    apaTagusMeasurements(
        "A part of the station's name, such as Fratel."
        station: String
        "A part of the parameter's name, such as Caudal médio diário (mean daily flow)."
        parameter: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaTagusMeasurementPage

    """
    The ecological, chemical and overall status of each river water body of mainland Portugal, from the third
    river basin management plans (2022 to 2027). Use it to tell whether a river is in a good state.
    """
    apaRiverStatus(
        "A part of the water body's name, such as Rio Mondego."
        name: String
        "A part of the hydrographic region's name, such as Douro or Tejo."
        region: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaRiverStatusPage

    """
    The ecological, chemical and overall status of the reservoirs, estuaries and coastal waters of mainland
    Portugal, 214 water bodies, from the third river basin management plans.
    """
    apaLakeCoastalStatus(
        "A part of the water body's name, such as Aguieira."
        name: String
        "A part of the hydrographic region's name, such as Douro or Tejo."
        region: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaLakeCoastalStatusPage

    """
    The chemical status of the territorial waters of mainland Portugal, one water body for each of the eight
    hydrographic regions.
    """
    apaTerritorialWaterStatus(
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaTerritorialWaterStatusPage

    """
    The quantitative and chemical status of each groundwater body (aquifer) of mainland Portugal, and whether
    it is at risk, from the third river basin management plans.
    """
    apaGroundwaterStatus(
        "A part of the aquifer's name, such as Querença."
        name: String
        "A part of the hydrographic region's name, such as Douro or Tejo."
        region: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaGroundwaterStatusPage

    """
    The catchments of the surface water bodies of mainland Portugal with their sub-basin and status. Use it to
    find the water bodies of a sub-basin.
    """
    apaWaterBodyBasins(
        "A part of the sub-basin's name, such as Leça or Sousa."
        subBasin: String
        "A part of the hydrographic region's name, such as Douro or Tejo."
        region: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaWaterBodyBasinPage

    """
    The priority substances that keep surface water bodies of mainland Portugal from a good chemical status,
    such as mercury or cadmium, by water body.
    """
    apaPrioritySubstances(
        "A part of the water body's name, such as Rio Leça."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaPrioritySubstancePage

    """
    The pollutants that keep groundwater bodies of mainland Portugal from a good chemical status, such as
    pesticides, by aquifer.
    """
    apaGroundwaterPollutants(
        "A part of the aquifer's name, such as Aveiro."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaGroundwaterPollutantPage

    """
    The water exploitation index (WEI+) of the sub-basins of mainland Portugal from 1989 to 2015: the ratio of
    the water used to the renewable water. Above 0.2 signals water stress, above 0.4 severe scarcity.
    """
    apaWaterScarcityBasins(
        "A part of the sub-basin's name, such as Sado."
        subBasin: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaWaterScarcityBasinPage

    """
    The water exploitation index (WEI+) of the groundwater bodies of mainland Portugal from 1930 to 2015: the
    ratio of the water pumped to the aquifer's recharge.
    """
    apaWaterScarcityAquifers(
        "A part of the aquifer's name, such as Querença."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaWaterScarcityAquiferPage

    """
    The stations that sample the quality of the rivers, reservoirs and estuaries of Portugal, in APA's water
    information system SNIRH.
    """
    apaSurfaceWaterStations(
        "A part of the station's name, such as Valença."
        name: String
        "The municipality, such as Valença. Case does not matter."
        municipality: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaSurfaceWaterStationPage

    """
    The stations of the network that monitors the status of the surface waters of mainland Portugal under the
    Water Framework Directive.
    """
    apaSurfaceMonitoringNetwork(
        "A part of the station's name, such as Lezíria."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaSurfaceMonitoringSitePage

    "The wells, piezometers and springs that monitor the quantity of groundwater in mainland Portugal."
    apaGroundwaterLevelNetwork(
        "A part of the point's name, such as Ansião."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaGroundwaterLevelSitePage

    "The wells and springs that monitor the chemical status of groundwater in mainland Portugal."
    apaGroundwaterQualityNetwork(
        "A part of the point's name, such as Carregal."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaGroundwaterQualitySitePage

    "The stations where APA samples the sediments of rivers, estuaries and coastal waters of Portugal."
    apaSedimentStations(
        "A part of the station's name, such as Caminha."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaSedimentStationPage

    """
    The rivers of mainland Portugal as water bodies of the Water Framework Directive, as named stretches.
    """
    apaWaterBodies(
        "A part of the river's name, such as Ribeira do Taveiro."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaWaterBodyPage

    """
    The six hydrogeological units of mainland Portugal, the large geological regions that hold its
    groundwater, such as Maciço Antigo or Orla Ocidental.
    """
    apaHydrogeologicalUnits(
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaHydrogeologicalUnitPage

    """
    The extended protection zones around the wells and springs that supply drinking water in mainland
    Portugal, with the order that created each.
    """
    apaWellProtectionZones(
        "A part of the abstraction's name, such as Espinheira."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaWellProtectionZonePage

    """
    The approved protection perimeters of public groundwater abstractions in the Tagus and West region, with
    the water company that runs them, such as EPAL or Águas de Cascais.
    """
    apaApprovedProtectionPerimeters(
        "A part of the water company's name, such as EPAL."
        operator: String
        "A part of the abstraction site's name, such as Alviela."
        site: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaProtectionPerimeterPage

    """
    The nine zones of mainland Portugal where farming nitrates pollute the groundwater, such as Esposende -
    Vila do Conde, under the Nitrates Directive.
    """
    apaNitrateVulnerableZones(
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaNitrateVulnerableZonePage

    """
    The mineral springs of Portugal, such as Curia, with their temperature, mineral content, uses and
    suggested therapies.
    """
    apaMineralSprings(
        "A part of the spring's name, such as Curia."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaMineralSpringPage

    """
    The areas of mainland Portugal with a potentially significant flood risk (ARPSI) in the second flood risk
    management plans, such as Coimbra on the Mondego or Alcácer do Sal on the Sado.
    """
    apaFloodRiskAreas(
        "A part of the place's name, written without accents, such as Coimbra or Alcacer do Sal."
        place: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaFloodRiskAreaPage

    """
    The areas with a potentially significant flood risk proposed for the third flood risk cycle (2025), 32
    river stretches such as Valença on the Minho, with their size.
    """
    apaProposedFloodRiskAreas(
