    apaRiverbedAlterations(
        "A part of the name, such as Ázere."
        name: String
        "The number of records to return, at most 200."
        first: Int = 20
    ): ApaRiverbedAlterationPage

    """
    The river basin management plans' record of the extractions of sand and gravel of mainland Portugal, as
